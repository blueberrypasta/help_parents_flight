# ============================================
# 하늘 MVP - 환경 변수 설정
# 이 파일을 .env로 복사한 뒤 값을 채워주세요
# cp .env.example .env
# ============================================

# --- Twilio ---
# https://console.twilio.com 에서 확인
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# --- OpenAI ---
# https://platform.openai.com/api-keys 에서 발급
# Realtime API 사용 (gpt-4o-realtime-preview)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# --- SerpAPI ---
# https://serpapi.com 에서 가입 후 API key 발급
# Google Flights 검색에 사용
SERPAPI_KEY=your_serpapi_key_here

# --- Server ---
# ngrok 등으로 터널링 후 공개 URL 입력
SERVER_URL=https://your-domain.ngrok-free.app
PORT=3000
